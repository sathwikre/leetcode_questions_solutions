class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> ans=new ArrayList<>();
        find(ans,n,0,0,"");
        return ans;
    }
    static void find(List<String> ans,int n,int o,int c,String s){
        if(s.length()==n*2){
            ans.add(s);
            return;
        }
        if(o<n) find(ans,n,o+1,c,s+"(");
        if(c<o) find(ans,n,o,c+1,s+")");
    }
}
