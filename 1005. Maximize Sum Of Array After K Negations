class Solution {
    public int largestSumAfterKNegations(int[] nums, int k) {
        for(int i=0;i<k;i++){
            int mini=0;
            for(int j=0;j<nums.length;j++){
                if(nums[mini]>nums[j]){
                    mini=j;
                }
            }
            nums[mini]=-1*nums[mini];
        }
        int sum=0;
        for(int val:nums){
            sum+=val;
        }
        return sum;
    }
}
