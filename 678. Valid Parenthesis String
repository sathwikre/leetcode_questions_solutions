class Solution {
    public boolean checkValidString(String s) {
        int n = s.length();

        int[][] dp = new int[n][n + 1];

        for (int[] a : dp) {
            Arrays.fill(a, -1);
        }

        return find(s, 0, 0, dp);
    }

    static boolean find(String s, int i, int c, int[][] dp) {
        if (c < 0) return false;

        if (i == s.length()) {
            return c == 0;
        }

        if (dp[i][c] != -1) {
            return dp[i][c] == 1;
        }

        char ch = s.charAt(i);

        if (ch == '(') {
            dp[i][c] = find(s, i + 1, c + 1, dp) ? 1 : 0;
        }
        else if (ch == ')') {
            dp[i][c] = find(s, i + 1, c - 1, dp) ? 1 : 0;
        }
        else {
            dp[i][c] =
                (find(s, i + 1, c + 1, dp) ||
                 find(s, i + 1, c - 1, dp) ||
                 find(s, i + 1, c, dp)) ? 1 : 0;
        }

        return dp[i][c] == 1;
    }
}
