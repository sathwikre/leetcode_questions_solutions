class Solution {
    public void rotate(int[] arr, int k) {
        int[] ans=find(arr,k);
        for(int i=0;i<arr.length;i++){
            arr[i]=ans[i];
        }
    }
    static int[] find(int[] arr,int k){
        if(arr.length<=1) return arr;
        k=k%arr.length;
        int[] ans=new int[arr.length];
        int i=arr.length-k;
        int ind=0;
        for(int j=i;j<arr.length;j++){
            ans[ind]=arr[j];
            ind++;
        }
        for(int j=0;j<i;j++){
            ans[ind]=arr[j];
            ind++;
        }
        return ans;
    }
}
