class Solution {
    public int maxProduct(int[] nums) {
        return find(nums);
    }
    
    static int find(int[] arr) {
       int max=Integer.MIN_VALUE;
       if(arr.length==1){
        return arr[0];
       }
       for(int i=0;i<arr.length;i++){
        int ans=arr[i];
        max = Math.max(max, ans);
        for(int j=i+1;j<arr.length;j++){
            ans=ans*arr[j];
            max=Math.max(ans,max);
        }
        max=Math.max(ans,max);
       }
       return max;
    }
}
