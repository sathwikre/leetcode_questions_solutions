class Solution {
    public boolean checkDivisibility(int n) {
        int sum=0;
        int temp=n;
        int prod=1;
        while(n>0){
            int rem=n%10;
            n=n/10;
            sum+=rem;
            prod=prod*rem;
        }
        if(temp % (prod+sum)==0){
            return true;
        }
        return false;
    }
}
