class Solution {
    public int smallestNumber(int n, int t) {
        for(int i=n;i<=n+10;i++){
            int prod=find(i);
            if(prod%t==0){
                return i;
            }
        }
        return -1;
    }
    static int find(int n){
        int prod=1;
        while(n>0){
                int rem=n%10;
                prod=prod*rem;
                n=n/10;
            }
            return prod;
    }
}
