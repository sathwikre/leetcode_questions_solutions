class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int m=piles[0];
        int ans=h;
        for(int i:piles){
            m=Math.max(m,i);
        }
        int s=1;
        int e=m;
        while(s<=e){
            int mid=(s+e)/2;
            if(find(piles,mid,h)){
                ans=mid;
                e=mid-1;
            }else{
                s=mid+1;
            }
        }
        return ans;
    }
    static boolean find(int[] arr,int p,int h){
        long sum=0;
        for(int i:arr){
            sum=sum+(i+p-1)/p;

        }
        return sum<=h;
    }
}
