class Solution {
    public int scoreOfParentheses(String s) {
        Stack<Integer> st =new Stack<>();
        st.push(0);
        for(char ch:s.toCharArray()){
            if(ch=='('){
                st.push(0);
            }else{
                int val=st.pop();
                if(val==0){
                    val=1;
                }else{
                    val=2*val;
                }
                st.push(val+st.pop());
            }
        }
        return st.pop();
    }
}