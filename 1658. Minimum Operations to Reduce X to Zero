class Solution {
    public int minOperations(int[] nums, int x) {
        int max=-1;
        int i=0;
        int total=0;
        for(int n:nums){
            total+=n;
        }
        int target=total-x;
        if(target==0) return nums.length;
        int sum=0;
        for(int j=0;j<nums.length;j++){
            sum+=nums[j];
            while(sum>target&&i<j){
                sum-=nums[i];
                i++;
            }
            if(sum==target){
                max=Math.max(max,j-i+1);
            }
        }
        if(max==-1){
            return -1;
        }
        return nums.length-max;
    }

}
