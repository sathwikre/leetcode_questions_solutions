class Solution {
    public boolean exist(char[][] board, String word) {
        for(int i=0;i<board.length;i++){
            for(int j=0;j<board[0].length;j++){
                if(board[i][j]==word.charAt(0)){
                    if(find(board,i,j,word,0)){
                        return true;
                    }
                }
            }
        }
        return false;
    }
    static boolean find(char[][] arr,int i,int j,String w,int k){
        if(k==w.length()) return true;
        if(i<0||i>arr.length-1||j<0||j>arr[0].length-1||k>w.length()||w.charAt(k)!=arr[i][j]){
            return false;
        }
        char ch=arr[i][j];
        arr[i][j]='#';
        boolean u=find(arr,i+1,j,w,k+1);
        boolean d=find(arr,i,j+1,w,k+1);
        boolean l=find(arr,i-1,j,w,k+1);
        boolean r=find(arr,i,j-1,w,k+1);

        arr[i][j]=ch;
        return u||l||r||d;
    }
}
