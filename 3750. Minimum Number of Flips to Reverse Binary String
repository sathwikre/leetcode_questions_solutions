class Solution {
    public int minimumFlips(int n) {
        StringBuilder sb=new StringBuilder(Integer.toBinaryString(n));
        String ss=sb.toString();
        sb.reverse();
        String s=sb.toString();
        int c=0;
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)!=ss.charAt(i)){
                c++;
            }
        }
        return c;
    }
}
