class Solution {
    public int subarraySum(int[] nums) {
       
        int[] pre=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            int sum=0;
            int st=Math.max(0,i-nums[i]);
            for(int j=st;j<=i;j++){
                sum+=nums[j];
                 
            }
           pre[i]=sum;
        }
        int s=0;
        for(int i=0;i<pre.length;i++){
            s+=pre[i];
        }
        return s;
    }
}
