class Solution {
    public int longestSubsequence(int[] nums) {
        int ans=0;
        boolean flag=true;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==0&&flag){
                flag=true;
            }else{
                flag=false;
            }
        }
        for(int val:nums){
            ans^=val;
        }
        if(ans!=0){
            return nums.length;
        }
        else if(!flag&&ans==0){
            return nums.length-1;
        }else{
            return 0;
        }
        
    }
}
