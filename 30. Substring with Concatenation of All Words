class Solution {
    public List<Integer> findSubstring(String s, String[] words) {
        int total=words[0].length()*words.length;
           Arrays.sort(words);
        List<Integer> ans=new ArrayList<>();
        for(int i=0;i<=s.length()-total;i++){
            List<String> sub=new ArrayList<>();
            String es=s.substring(i,i+total);
            for(int j=0;j<es.length();j+=words[0].length()){
                String a=es.substring(j,j+words[0].length());
                sub.add(a);
            }
            Collections.sort(sub);
         
            if(sub.equals(Arrays.asList(words))){
                ans.add(i);
            }
        }
        return ans;
    }
}
