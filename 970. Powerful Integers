class Solution {
    public List<Integer> powerfulIntegers(int x, int y, int bound) {
        List<Integer> ans=new ArrayList<Integer>();
        for(int i=0;i<100;i++){
            for(int j=0;j<100;j++){
                int val=(int)(Math.pow(x,i)+Math.pow(y,j));
                if(val<=bound){
                  if(!ans.contains(val)){
                      ans.add(val);
                  }
                }else{
                    break;
                }
            }
        }
        return ans;
    }
}
