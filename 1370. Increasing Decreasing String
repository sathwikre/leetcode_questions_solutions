
class Solution {
    public String sortString(String s) {
        StringBuilder sb = new StringBuilder();
        int[] count = new int[26];

        for (char ch : s.toCharArray()) {
            count[ch - 'a']++;
        }

        int i = 0;
        boolean flag = true;

        while (sb.length() < s.length()) {
            if (flag) {
                if (count[i] > 0) {
                    sb.append((char)(i + 'a'));
                    count[i]--;
                }

                if (i == 25) {
                    flag = false;
                } else {
                    i++;
                }
            } else {
                if (count[i] > 0) {
                    sb.append((char)(i + 'a'));
                    count[i]--;
                }

                if (i == 0) {
                    flag = true;
                } else {
                    i--;
                }
            }
        }

        return sb.toString();
    }
}
