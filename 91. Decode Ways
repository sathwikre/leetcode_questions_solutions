class Solution {
    public int numDecodings(String s) {
        int[] dp=new int[s.length()];
        Arrays.fill(dp,-1);
        return find(0,s,dp);
    }
    static int find(int i,String s,int[] dp){
       if(i==s.length()){
            return 1;
       }
       if(s.charAt(i)=='0'){
        return 0;
       }
       if(dp[i]!=-1) return dp[i];
       int left=find(i+1,s,dp);
       
       if(i+1<s.length()){
        int val=Integer.parseInt(s.substring(i,i+2));
        if(val>=10&&val<=26){
            left+=find(i+2,s,dp);
        }
         
       }
     
       return dp[i]=left;
    }
}
