class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length==0) return 0;
        Arrays.sort(nums);
        int r=1;int l=0;
        int max=0;
        int c=1;
        while(r<nums.length){
            if(nums[r]-nums[r-1]==1||nums[r]==nums[r-1]){
                if(nums[r]!=nums[r-1]){
                c++;
                max=Math.max(max,c);
                }else{
                    max=Math.max(max,c);
                }
               
            }else{
                c=1;
                l=r;
            }
            r++;
        }
        max=Math.max(max,c);
        return max;
    }
}
