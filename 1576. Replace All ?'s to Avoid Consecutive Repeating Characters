class Solution {
    public String modifyString(String s) {
        
        char[] ch=s.toCharArray();
       
        for(int i=0;i<ch.length;i++){
            if(ch[i]=='?'){
                
                for (char c = 'a'; c <= 'c'; c++) {

                    if (i > 0 && ch[i - 1] == c)
                        continue;

                    if (i < ch.length - 1 && ch[i + 1] == c)
                        continue;

                    ch[i] = c;
                    break;
                }
            }
        }
        return new String(ch);
    }
}
