/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
 int ans=0;
    public int averageOfSubtree(TreeNode root) {
       find(root);
       return ans;
    }
    int[] find(TreeNode node){
        if(node==null){
            return new int[]{0,0};
        }
        int[] l=find(node.left);
        int[] r=find(node.right);
        int sum=l[0]+r[0]+node.val;
        int c=l[1]+r[1]+1;
        if(node.val==sum/c){
            ans++;
        }
        return new int[]{sum,c};
    }
}
